---
// src/layouts/Layout.astro
import ClientRouter from 'astro/components/ClientRouter.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/utilities.css';

const { title = '数字花园' } = Astro.props;
const hasSidebar = Astro.slots.has('sidebar');
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <!-- 引入 Pico.css -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
    />
  </head>
  <body>
    <ClientRouter />
    <div class="page-wrapper">
      <header class="site-header">
        <div class="site-header__inner container">
          <a class="brand" href="/">
            <span class="brand__badge">J</span>
            <span>Jenway 的数字花园</span>
          </a>
          <nav class="site-nav" aria-label="主导航">
            <a href="/">主页</a>
            <a href="/posts/">文章</a>
            <a href="/tweets/">片段</a>
            <a href="/novels/">小说</a>
          </nav>
        </div>
      </header>

      <main
        class="site-main container"
        data-has-sidebar={hasSidebar ? 'true' : 'false'}
      >
        <article class="site-content">
          <slot />
        </article>
        {
          hasSidebar && (
            <aside class="site-sidebar">
              <slot name="sidebar" />
            </aside>
          )
        }
      </main>

      <footer class="site-footer">
        <div class="site-footer__inner container">
          <span class="muted"
            >© {currentYear} Jenway. 保留一切保留不了的权利。</span
          >
          <div class="footer-links">
            <a href="mailto:mail@jenway.link">mail@jenway.link</a>
            <a href="https://hexo.jenway.link" rel="noopener" target="_blank"
              >旧站存档</a
            >
            <a href="/tweets/">片段流</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
