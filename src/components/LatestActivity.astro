---
import Card from './ui/Card.astro';
import { getPublicEntries } from '../utils/content';

interface ActivityItem {
  date: Date;
  title: string;
  url: string;
}

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

let recentActivity: ActivityItem[] = [];

try {
  const posts = await getPublicEntries('Posts', { limit: 5 });

  recentActivity = posts
    .map((post) => ({
      date: post.data.pubDate,
      title: post.data.title ?? post.slug,
      url: `/posts/${post.slug}/`,
    }))
    .sort((left, right) => right.date.valueOf() - left.date.valueOf())
    .slice(0, 5);
} catch (error) {
  console.error('Error fetching recent activity:', error);
}
---

<section class="latest-activity">
  {
    recentActivity.length > 0 ? (
      <ul class="latest-activity__list list--unstyled list--spaced">
        {recentActivity.map((item) => (
          <li>
            <Card
              href={item.url}
              variant="interactive"
              class="latest-activity__card"
              aria-label={item.title}
            >
              <span class="latest-activity__title">
                <span>{item.title}</span>
              </span>
              <time class="text-muted text-sm text-nowrap">
                {dateFormatter.format(item.date)}
              </time>
            </Card>
          </li>
        ))}
      </ul>
    ) : (
      <Card>
        <p class="text-muted">内容索引正在整理中，稍后会显示最近活动。</p>
      </Card>
    )
  }
</section>
