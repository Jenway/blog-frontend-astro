---
interface BaseProps {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'default' | 'sm';
  disabled?: boolean;
  class?: string;
}

type LinkProps = BaseProps & {
  href: string;
  type?: never;
};

type ButtonProps = BaseProps & {
  href?: undefined;
  type?: 'button' | 'submit' | 'reset';
};

const {
  variant = 'primary',
  size = 'default',
  disabled = false,
  href,
  type = 'button',
  class: className = '',
  ...props
} = Astro.props as LinkProps | ButtonProps;

const variantClasses = {
  primary: 'btn--primary',
  secondary: 'btn--secondary',
  outline: 'btn--outline',
};

const sizeClasses = {
  default: '',
  sm: 'btn--sm',
};

const classes = [
  'btn',
  variantClasses[variant],
  sizeClasses[size],
  disabled ? 'btn--disabled' : '',
  className,
]
  .filter((value): value is string => value.length > 0)
  .join(' ');
---

{
  href ? (
    <a
      class={classes}
      href={disabled ? undefined : href}
      aria-disabled={disabled ? 'true' : undefined}
      {...props}
    >
      <slot />
    </a>
  ) : (
    <button class={classes} type={type} disabled={disabled} {...props}>
      <slot />
    </button>
  )
}
