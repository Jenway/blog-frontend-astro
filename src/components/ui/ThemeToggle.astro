<details class="theme-toggle-host" data-theme-menu>
  <summary class="theme-toggle" data-theme-toggle-button>
    <span aria-hidden="true" class="theme-toggle__indicator"></span>
    <span data-theme-toggle-label>跟随系统</span>
  </summary>

  <div class="theme-menu" role="menu" aria-label="主题切换">
    <button class="theme-menu__item" type="button" data-theme-option="system">
      跟随系统
    </button>
    <button class="theme-menu__item" type="button" data-theme-option="light">
      日间模式
    </button>
    <button class="theme-menu__item" type="button" data-theme-option="dark">
      夜间模式
    </button>
  </div>
</details>
