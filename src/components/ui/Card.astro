---
interface Props {
  variant?: 'default' | 'interactive' | 'sidebar' | 'archive';
  as?: 'div' | 'section' | 'article';
  href?: string;
  class?: string;
}

const {
  variant = 'default',
  as = 'div',
  href,
  class: className = '',
  ...props
} = Astro.props as Props;

const variantClasses = {
  default: '',
  interactive: 'card--interactive',
  sidebar: 'card--sidebar',
  archive: 'card--archive',
};

const classes = ['card', variantClasses[variant], className]
  .filter((value): value is string => value.length > 0)
  .join(' ');

const Component = href ? 'a' : as;
---

<Component class={classes} href={href} {...props}>
  <slot />
</Component>
