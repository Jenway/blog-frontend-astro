---
// src/components/PostsPagination.astro
import { getPublicEntries } from '../utils/content';
import Layout from '../layouts/Layout.astro';
import Card from './ui/Card.astro';
import Pagination from './ui/Pagination.astro';
import { getPageSlice, getTotalPages } from '../utils/pagination';

interface Props {
  currentPage: number;
}

const { currentPage } = Astro.props;

const posts = await getPublicEntries('Posts');
const postsPerPage = 10;
const totalPages = getTotalPages(posts.length, postsPerPage);
const paginatedPosts = getPageSlice(posts, currentPage, postsPerPage);

const anchorId = 'posts-top';
const currentIndexPath =
  currentPage === 1 ? '/posts/' : `/posts/${currentPage}/`;

const pageTitle =
  currentPage === 1 ? '文章目录' : `文章目录 - 第 ${currentPage} 页`;
---

<Layout
  title={pageTitle}
  description="按时间整理的文章目录，收录 Jenway 的长文写作与归档内容。"
>
  <div class="archive" id={anchorId}>
    <header class="archive__header">
      <h1>所有文章</h1>
      {
        totalPages > 1 && (
          <div class="archive__meta">
            <span>第 {currentPage} 页</span>
            <span>共 {totalPages} 页</span>
            <span>{posts.length} 篇文章</span>
          </div>
        )
      }
    </header>

    <ul class="list--unstyled list--spaced-lg">
      {
        paginatedPosts.map((post) => (
          <li>
            <Card variant="archive">
              <h3 class="archive__title">
                <a
                  href={`/posts/${post.slug}/?from=${encodeURIComponent(currentIndexPath)}`}
                  class="archive__link"
                >
                  {post.data.title}
                </a>
              </h3>
              {post.data.pubDate && (
                <div class="archive__meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('zh-CN')}
                  </time>
                </div>
              )}
            </Card>
          </li>
        ))
      }
    </ul>

    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      baseUrl="/posts/"
      anchorId={anchorId}
    />
  </div>
</Layout>
