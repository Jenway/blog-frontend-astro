---
// src/components/PostsPagination.astro
import { getPublicEntries } from '../utils/content';
import Layout from '../layouts/Layout.astro';
import Card from './ui/Card.astro';
import Pagination from './ui/Pagination.astro';

interface Props {
  currentPage: number;
}

const { currentPage } = Astro.props;

const posts = await getPublicEntries('Posts');
const postsPerPage = 10;
const totalPages = Math.ceil(posts.length / postsPerPage);
const startIndex = (currentPage - 1) * postsPerPage;
const endIndex = startIndex + postsPerPage;
const paginatedPosts = posts.slice(startIndex, endIndex);

const anchorId = 'posts-top';

const pageTitle =
  currentPage === 1 ? '文章目录' : `文章目录 - 第 ${currentPage} 页`;
const pageHeading =
  currentPage === 1
    ? '所有文章'
    : `所有文章 <small>第 ${currentPage} 页</small>`;

const hasPagination = totalPages > 1;
---

<Layout title={pageTitle}>
  <div class="archive" id={anchorId}>
    <header class="archive__header">
      <span class="eyebrow">Archive</span>
      <h2 set:html={pageHeading} />
    </header>

    <ul class="list--unstyled list--spaced-lg">
      {
        paginatedPosts.map((post) => (
          <li>
            <Card variant="archive">
              <h3 class="archive__title">
                <a href={`/posts/${post.slug}/`} class="archive__link">
                  {post.data.title}
                </a>
              </h3>
              {post.data.pubDate && (
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-muted text-sm"
                >
                  {post.data.pubDate.toLocaleDateString()}
                </time>
              )}
            </Card>
          </li>
        ))
      }
    </ul>

    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      baseUrl="/posts/"
      anchorId={anchorId}
    />
  </div>
</Layout>
