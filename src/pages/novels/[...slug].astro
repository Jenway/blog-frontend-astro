---
// src/pages/novels/[...slug].astro
import { getPublicEntries } from '../../utils/content';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/ui/Card.astro';

export async function getStaticPaths() {
  const chapters = await getPublicEntries('Novels');
  return chapters.map((chapter) => ({
    params: { slug: chapter.slug },
    props: chapter,
  }));
}

const chapter = Astro.props;
const { Content } = await chapter.render();
---

<Layout
  title={`${chapter.data.title} - 小说`}
  description={chapter.data.description ??
    `小说章节《${chapter.data.title}》，第 ${chapter.data.chapter} 章。`}
>
  <Card as="article" class="prose-card">
    <header class="prose-card__header">
      <h1>{chapter.data.title}</h1>
      <div class="prose-card__meta">
        <span>第 {chapter.data.chapter} 章</span>
      </div>
    </header>
    <div class="prose-card__body">
      <Content />
    </div>
  </Card>
</Layout>
